{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^server-only$",
    "<SEPARATOR>",
    "<BUILTIN_MODULES>",
    "<SEPARATOR>",
    "<THIRD_PARTY_MODULES>",
    "<SEPARATOR>",
    "^@/actions/(.*)$",
    "^@/app/(.*)$",
    "^@/components/(.*)$",
    "^@/utils$",
    "^@/utils/(.*)$",
    "<SEPARATOR>",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}